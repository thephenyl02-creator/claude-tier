{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "summary"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "category", "evidence"],
        "properties": {
          "file": {"type": "string"},
          "category": {"type": "string"},
          "evidence": {"type": "string"}
        }
      }
    },
    "summary": {"type": "string"}
  }
}
